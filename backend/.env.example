# ─── Base de datos ────────────────────────────────────────
# Local (SQLite):
DATABASE_URL="file:./prisma/dev.db"
# Producción (Railway PostgreSQL — Railway lo inyecta automáticamente):
# DATABASE_URL="postgresql://user:password@host:5432/railway"

# ─── Servidor ─────────────────────────────────────────────
PORT=3001
JWT_SECRET="cambia-esto-por-un-secreto-seguro-de-32-chars"

# ─── CORS ─────────────────────────────────────────────────
# Local:
CORS_ORIGIN="http://localhost:3000"
# Producción (URL de Vercel):
# CORS_ORIGIN="https://castrogym.vercel.app"

# ─── Frontend URL (para emails de reset de contraseña) ────
FRONTEND_URL="http://localhost:3000"
# Producción:
# FRONTEND_URL="https://castrogym.vercel.app"

# ─── Email (Resend) — opcional ────────────────────────────
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# RESEND_FROM="Castro Gym <noreply@castrogym.com>"

# ─── OAuth Google — opcional ──────────────────────────────
# GOOGLE_CLIENT_ID=""
# RECAPTCHA_SECRET_KEY=""
