# URL del backend
# Local:
NEXT_PUBLIC_API_URL=http://localhost:3001

# Subpath de la app en producción (vacío en dev, /agendamedidas en prod)
# En producción se pasa directo al build: NEXT_PUBLIC_BASE_PATH=/agendamedidas npm run build
# En desarrollo dejar vacío o no definir — el frontend responde en localhost:3000
NEXT_PUBLIC_BASE_PATH=
